# Copy to .env.local and fill in (same Clerk + Supabase project as the mobile app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional: error monitoring (Sentry stays disabled when unset —
# keyless builds and local dev work without it).
NEXT_PUBLIC_SENTRY_DSN=

# Server-only (never NEXT_PUBLIC_*): account purge route + cron guard.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Ships the delete-with-grace flow dark until real users. "true" exposes the
# web danger zone and arms the purge route (mobile uses its own constant).
ACCOUNT_DELETION_ENABLED=

# Must match the mobile app: Supabase trusts Clerk JWTs via this template,
# and RLS compares user_id to the token `sub`.
# Clerk dashboard -> JWT Templates -> template named `supabase`.
