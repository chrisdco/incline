  "globalCss": "@tailwind base;\r\n@tailwind components;\r\n@tailwind utilities;\r\n\r\n@layer base {\r\n  * {\r\n    border-color: hsl(var(--border));\r\n  }\r\n}\r\n\r\n/*\r\n * Neutrals + semantic colors live on :root / .dark.\r\n * Brand accent (primary / ring / chart-1) is set by theme-* classes on the root View\r\n * so Settings can swap accents without touching the rest of the palette.\r\n * Default accent: indigo (also applied via theme-indigo on the root View).\r\n */\r\n:root {\r\n  --background: 240 20% 98%;\r\n  --foreground: 240 10% 3.9%;\r\n  --surface-1: 0 0% 100%;\r\n  --surface-2: 240 4.8% 95.9%;\r\n  --card: 0 0% 100%;\r\n  --card-foreground: 240 10% 3.9%;\r\n  --popover: 0 0% 100%;\r\n  --popover-foreground: 240 10% 3.9%;\r\n  --primary: 173 80% 32%;\r\n  --primary-foreground: 0 0% 100%;\r\n  --secondary: 240 4.8% 95.9%;\r\n  --secondary-foreground: 240 5.9% 10%;\r\n  --muted: 240 4.8% 95.9%;\r\n  --muted-foreground: 240 4% 40%;\r\n  --accent: 240 4.8% 95.9%;\r\n  --accent-foreground: 240 5.9% 10%;\r\n  --destructive: 0 72% 51%;\r\n  --destructive-foreground: 0 0% 98%;\r\n  --success: 142 64% 38%;\r\n  --success-foreground: 0 0% 100%;\r\n  --warning: 38 92% 50%;\r\n  --warning-foreground: 0 0% 100%;\r\n  --info: 217 91% 60%;\r\n  --info-foreground: 0 0% 100%;\r\n  --border: 240 5.9% 90%;\r\n  --input: 240 5.9% 90%;\r\n  --ring: 173 80% 32%;\r\n  --chart-1: 173 70% 38%;\r\n  --chart-2: 217 91% 60%;\r\n  --chart-3: 38 92% 50%;\r\n  --chart-4: 280 65% 60%;\r\n  --chart-5: 0 72% 55%;\r\n  --radius: 0.9rem;\r\n}\r\n\r\n.dark {\r\n  --background: 240 8% 5%;\r\n  --foreground: 0 0% 98%;\r\n  --surface-1: 240 7% 9%;\r\n  --surface-2: 240 6% 12%;\r\n  --card: 240 7% 9%;\r\n  --card-foreground: 0 0% 98%;\r\n  --popover: 240 6% 12%;\r\n  --popover-foreground: 0 0% 98%;\r\n  --primary: 172 66% 50%;\r\n  --primary-foreground: 240 10% 4%;\r\n  --secondary: 240 3.7% 15.9%;\r\n  --secondary-foreground: 0 0% 98%;\r\n  --muted: 240 3.7% 15.9%;\r\n  --muted-foregrou