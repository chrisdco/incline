{
  "expo": {
    "name": "Incline",
    "slug": "incline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "incline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/icon-preview.png"
      },
      "package": "com.chrisdc777.incline",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/icon-preview.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Incline uses your photos so you can attach gym pics to a finished workout.",
          "cameraPermission": "Incline uses the camera so you can snap a gym pic after you finish."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#6D5DF6"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
