{
  "expo": {
    "name": "Incline",
    "slug": "incline",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/16580a47-8678-42e0-8dc1-0ef7d38bb3a3"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "incline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/icon-preview.png"
      },
      "package": "com.chrisdc777.incline",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/icon-preview.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Incline uses your photos so you can attach gym pics to a finished workout.",
          "cameraPermission": "Incline uses the camera so you can snap a gym pic after you finish."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "@clerk/expo",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "QuickStart",
              "displayName": "Quick start",
              "description": "Start a workout or jump back into the one running.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 110,
                "minHeight": 40,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/quick-start.tsx",
                "previewLayout": "widget_preview_quick_start"
              }
            },
            {
              "name": "NextUp",
              "displayName": "Next workout",
              "description": "What to train next, with this week's volume against last week.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/next-up.tsx",
                "previewLayout": "widget_preview_next_up"
              }
            },
            {
              "name": "ThisWeek",
              "displayName": "This week",
              "description": "Workouts against your weekly goal, with the days you trained.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/this-week.tsx",
                "previewLayout": "widget_preview_this_week"
              }
            },
            {
              "name": "Streak",
              "displayName": "Streak",
              "description": "Weeks in a row with a workout, and what keeps it going.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 110,
                "minHeight": 40,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/streak.tsx",
                "previewLayout": "widget_preview_streak"
              }
            },
            {
              "name": "Month",
              "displayName": "Month",
              "description": "Calendar of trained days with workouts, time and volume against last month.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/month.tsx",
                "previewLayout": "widget_preview_month"
              }
            },
            {
              "name": "VolumeChart",
              "displayName": "Volume",
              "description": "Volume lifted each day over the last week.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/volume-chart.tsx",
                "previewLayout": "widget_preview_volume_chart"
              }
            },
            {
              "name": "Routines",
              "displayName": "Routines",
              "description": "Your recent routines, one tap from starting.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/routines.tsx",
                "previewLayout": "widget_preview_routines"
              }
            }
          ]
        }
      ],
      "@sentry/react-native",
      "./plugins/with-widget-previews"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "16580a47-8678-42e0-8dc1-0ef7d38bb3a3"
      }
    },
    "owner": "chrisdcosta"
  }
}
