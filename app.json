{
  "expo": {
    "name": "Incline",
    "slug": "incline",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "incline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/icon-preview.png"
      },
      "package": "com.chrisdc777.incline",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/icon-preview.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Incline uses your photos so you can attach gym pics to a finished workout.",
          "cameraPermission": "Incline uses the camera so you can snap a gym pic after you finish."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "@clerk/expo",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextUp",
              "displayName": "Next workout",
              "description": "Your next session and this week's progress at a glance.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/next-up.tsx"
              }
            },
            {
              "name": "ThisWeek",
              "displayName": "This week",
              "description": "Sessions logged this week against your goal.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "./src/widgets/this-week.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
