{
  "expo": {
    "name": "Incline",
    "slug": "incline",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/16580a47-8678-42e0-8dc1-0ef7d38bb3a3"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "incline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111113",
        "foregroundImage": "./assets/images/icon-preview.png",
        "monochromeImage": "./assets/images/icon-monochrome.png"
      },
      "package": "com.chrisdc777.incline",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f7",
          "image": "./assets/images/splash-mark-dark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111113",
            "image": "./assets/images/icon-preview.png"
          }
        }
      ],
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Incline uses your photos so you can attach gym pics to a finished workout.",
          "cameraPermission": "Incline uses the camera so you can snap a gym pic after you finish."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0D9488"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "@clerk/expo",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "QuickStart",
              "displayName": "Quick start",
              "description": "Start a workout or jump back into the one running.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 110,
                "minHeight": 40,
                "resizeMode": "horizontal",
                "initialLayout": "./src/widgets/quick-start.tsx",
                "previewLayout": "widget_preview_quick_start"
              }
            },
            {
              "name": "NextUp",
              "displayName": "Next workout",
              "description": "What to train next, with this week's volume against last week.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/next-up.tsx",
                "previewLayout": "widget_preview_next_up"
              }
            },
            {
              "name": "ThisWeek",
              "displayName": "This week",
              "description": "Workouts against your weekly goal, with the days you trained.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/this-week.tsx",
                "previewLayout": "widget_preview_this_week"
              }
            },
            {
              "name": "Streak",
              "displayName": "Streak",
              "description": "Weeks in a row with a workout, and what keeps it going.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "minWidth": 110,
                "minHeight": 40,
                "resizeMode": "horizontal",
                "initialLayout": "./src/widgets/streak.tsx",
                "previewLayout": "widget_preview_streak"
              }
            },
            {
              "name": "Month",
              "displayName": "Month",
              "description": "Calendar of trained days with workouts, time and volume against last month.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/month.tsx",
                "previewLayout": "widget_preview_month"
              }
            },
            {
              "name": "VolumeChart",
              "displayName": "Volume",
              "description": "Volume lifted each day over the last week.",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/volume-chart.tsx",
                "previewLayout": "widget_preview_volume_chart"
              }
            },
            {
              "name": "Routines",
              "displayName": "Routines",
              "description": "Your recent routines, one tap from starting.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/routines.tsx",
                "previewLayout": "widget_preview_routines"
              }
            }
          ]
        }
      ],
      "@sentry/react-native",
      "./plugins/with-widget-previews",
      "./plugins/with-app-shortcuts",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Incline saves your share cards to your photo library.",
          "granularPermissions": []
        }
      ],
      "@clerk/expo-google-signin",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Incline uses the microphone while you hold the mic button to ask a question.",
          "speechRecognitionPermission": "Incline turns what you say into text for your question, on your phone where possible.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "16580a47-8678-42e0-8dc1-0ef7d38bb3a3"
      }
    },
    "owner": "chrisdcosta"
  }
}
