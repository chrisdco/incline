{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "development"
      },
      "environment": "development"
    },
    "alpha": {
      "distribution": "internal",
      "channel": "alpha",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "alpha"
      },
      "environment": "preview"
    },
    "beta": {
      "distribution": "internal",
      "channel": "beta",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "beta"
      },
      "environment": "preview"
    },
    "preview": {
      "extends": "alpha",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "production"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
