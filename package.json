    "compiler:check": "node scripts/compiler-check.mjs",
    "test": "vitest run --config vitest.config.mts --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.config.mts integration",
    "test:all": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "supabase": "supabase",
    "tokens:css": "vitest run --config vitest.config.mts src/styles/__tests__/theme-tokens.test.ts -u"
